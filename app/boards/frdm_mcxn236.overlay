#include <zephyr/dt-bindings/display/panel.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/mcux-lpadc.h>
#include <zephyr/dt-bindings/regulator/nxp_vref.h>
#include <nxp/mcx/MCXN236VDF-pinctrl.h>

&gpio2 {
  status = "okay";
};

&gpio3 {
  status = "okay";
};

/* SW2 (user_button_2) is already enabled at board level for wake/sleep */
&user_button_3 {
  status = "okay";
};

/* Disable I2C bus that claims PIO4_0 and PIO4_1 */
&flexcomm2_lpi2c2 {
  status = "disabled";
};

/* Map PIO4_0 to ADC0_0 */
&pinctrl {
  pinmux_lpadc0_mq: pinmux_lpadc0_mq {
    group0 {
      pinmux = <ADC0_A0_PIO4_0>;
      slew-rate = "fast";
      drive-strength = "low";
    };
  };
};

/* External reference, high-power mode -- matches the board's own ADC sample overlay */
&vref {
  regulator-initial-mode = <NXP_VREF_MODE_HIGH_POWER>;
};

/*
 * Use the default LPADC0 configuration + the new LPADC0_MQ pinctrl group,
 * plus a channel node for the MQ3's analog input. ADC_DT_SPEC_INST_GET()
 * (used in mq.c) only fills in .resolution/.oversampling/.channel_cfg from
 * a channel@N child node like this one -- without it those fields are left
 * unset, which is what caused the "initializer element is not constant"
 * build error.
 */
&lpadc0 {
  pinctrl-0 = <&pinmux_lpadc0>, <&pinmux_lpadc0_mq>;

  #address-cells = <1>;
  #size-cells = <0>;

  channel@0 {
    reg = <0>;
    zephyr,gain = "ADC_GAIN_1";
    zephyr,reference = "ADC_REF_EXTERNAL1";
    zephyr,vref-mv = <1800>;
    zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
    zephyr,resolution = <12>;
    zephyr,input-positive = <MCUX_LPADC_CH0A>; /* P4_0 = ADC0_A0, per pinmux_lpadc0_mq above */
  };
};

/ {
  chosen {
    zephyr,display = &ili9341;
  };

  mipi_dbi_par: mipi-dbi-parallel {
    compatible = "zephyr,mipi-dbi-bitbang";
    /*
     * lcdwiki/MCUFRIEND 2.4" ILI9341 shield (nRF5340 DK Arduino header):
     *   A0=P0.04 → RD      A1=P0.05 → WR
     *   A2=P0.06 → RS/DC   A3=P0.07 → CS (active-low)
     *   A4=P0.25 → RST     (active-low)
     */
    reset-gpios = <&gpio4 12  GPIO_ACTIVE_LOW>;   /* A4 = RST   */
    cs-gpios    = <&gpio4 17  GPIO_ACTIVE_LOW>;   /* A3 = CS    */
    dc-gpios    = <&gpio4 16  GPIO_ACTIVE_HIGH>;  /* A2 = RS/DC */
    wr-gpios    = <&gpio4 15  GPIO_ACTIVE_HIGH>;  /* A1 = WR    */
    rd-gpios    = <&gpio4 6   GPIO_ACTIVE_HIGH>;  /* A0 = RD    */
    /*
     * MCUFRIEND wiring: DB0→D8, DB1→D9, DB2→D2 … DB7→D7
     * (data-gpios[i] → bit i of the byte → DBi of controller)
     *   DB0=D8=P0.23  DB1=D9=P3.14  DB2=D2=P2.0  DB3=D3=P3.12
     *   DB4=D4=P0.21  DB5=D5=P2.7   DB6=D6=P3.17 DB7=D7=P0.22
     */
    data-gpios  = <&gpio0 23 GPIO_ACTIVE_HIGH>,   /* DB0 = D8 */
                  <&gpio3 14 GPIO_ACTIVE_HIGH>,   /* DB1 = D9 */
                  <&gpio2  0 GPIO_ACTIVE_HIGH>,   /* DB2 = D2 */
                  <&gpio3 12 GPIO_ACTIVE_HIGH>,   /* DB3 = D3 */
                  <&gpio0 21 GPIO_ACTIVE_HIGH>,   /* DB4 = D4 */
                  <&gpio2  7 GPIO_ACTIVE_HIGH>,   /* DB5 = D5 */
                  <&gpio3 17 GPIO_ACTIVE_HIGH>,   /* DB6 = D6 */
                  <&gpio0 22 GPIO_ACTIVE_HIGH>;   /* DB7 = D7 */
    #address-cells = <1>;
    #size-cells    = <0>;

    ili9341: ili9341@0 {
      compatible        = "ilitek,ili9341";
      reg               = <0>;
      mipi-mode         = "MIPI_DBI_MODE_8080_BUS_8_BIT";
      mipi-max-frequency = <10000000>;
      pixel-format      = <PANEL_PIXEL_FORMAT_RGB_565X>;
      width             = <240>;
      height            = <320>;
      rotation          = <90>;   /* 0 | 90 | 180 | 270 CW — adjust to match physical mount */
      h-mirror;
    };
  };

  mq2: mq2 {
    compatible            = "winsen,mq2";
    io-channels           = <&lpadc0 0>;
    do-gpios              = <&gpio4 1 GPIO_ACTIVE_LOW>;
    load-resistance-ohms  = <1000>;
    ro-clean-air-ohms     = <5800>;
  };
};
